<?xml version="1.0" encoding="UTF-8"?>

<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0
                             https://maven.apache.org/xsd/maven-4.0.0.xsd">

    <modelVersion>4.0.0</modelVersion>

    <groupId>br.com.meslin</groupId>
    <artifactId>grpc-calculadora</artifactId>
    <version>1.0-SNAPSHOT</version>
    <packaging>jar</packaging>

    <!-- ========================================================= -->
    <!-- Versões                                                   -->
    <!-- ========================================================= -->

    <!-- Valores que podem ser reutilizados em outras partes do projeto -->
    <properties>
        <grpc.version>1.84.0</grpc.version>                                 <!-- Versão do gRPC -->
        <protobuf.version>3.25.8</protobuf.version>                         <!-- Versão do Protocol Buffers -->
        <protoc.version>3.25.8</protoc.version>                             <!-- Versão do compilador protoc -->
        <maven.compiler.source>11</maven.compiler.source>                   <!-- Versão do Java para compilação -->
        <maven.compiler.target>11</maven.compiler.target>                   <!-- Versão do Java para execução -->
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>  <!-- Codificação de caracteres para arquivos fonte -->
    </properties>

    <!-- ========================================================= -->
    <!-- Dependências                                              -->
    <!-- ========================================================= -->

    <dependencyManagement>
        <dependencies>
            <!-- Gerenciamento de dependências do gRPC -->
            <dependency>
                <groupId>io.grpc</groupId>
                <artifactId>grpc-bom</artifactId>   <!-- Gerencia as versões das dependências do gRPC (BOM - Bill of Materials) -->
                <version>${grpc.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <dependencies>
        <dependency>
            <!-- Implementação do transporte HTTP/2 para o gRPC -->
            <groupId>io.grpc</groupId>
            <artifactId>grpc-netty-shaded</artifactId>
        </dependency>

        <dependency>
            <!-- Integração do gRPC com o Protocol Buffers -->
            <groupId>io.grpc</groupId>
            <artifactId>grpc-protobuf</artifactId>
        </dependency>

        <dependency>
            <!-- Stub Java gerado pelo protoc -->
            <groupId>io.grpc</groupId>
            <artifactId>grpc-stub</artifactId>
        </dependency>
    </dependencies>

    <!-- ========================================================= -->
    <!-- Build                                                     -->
    <!-- ========================================================= -->

    <build>
        <extensions>
            <extension>
                <!-- Plugin para detectar o sistema operacional para executar o protoc adequado -->
                <groupId>kr.motd.maven</groupId>
                <artifactId>os-maven-plugin</artifactId>
                <version>1.7.1</version>
            </extension>
        </extensions>

        <plugins>
            <!-- ================================================= -->
            <!-- Protocol Buffers / gRPC                           -->
            <!-- ================================================= -->

            <plugin>
                <!-- Plugin para gerar código Java a partir de arquivos .proto -->
                <groupId>org.xolstice.maven.plugins</groupId>
                <artifactId>protobuf-maven-plugin</artifactId>
                <version>0.6.1</version>
                <configuration>
                    <!-- protoc -->
                    <protocArtifact>
                        com.google.protobuf:protoc:${protoc.version}:exe:${os.detected.classifier}
                    </protocArtifact>
                    <!-- Gerador de código gRPC -->
                    <pluginId>grpc-java</pluginId>
                    <pluginArtifact>
                        io.grpc:protoc-gen-grpc-java:${grpc.version}:exe:${os.detected.classifier}
                    </pluginArtifact>
                    <!-- Arquivos .proto -->
                    <protoSourceRoot>
                        src/main/resources
                    </protoSourceRoot>
                </configuration>
                <!-- Execução do plugin -->
                <executions>
                    <execution>
                        <goals>
                            <!-- Compila os arquivos .proto -->
                            <goal>compile</goal>
                            <goal>compile-custom</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>


            <!-- ================================================= -->
            <!-- JAR                                               -->
            <!-- ================================================= -->

            <plugin>
                <!-- Plugin para empacotar o projeto em um arquivo JAR -->
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-jar-plugin</artifactId>
                <version>3.4.2</version>
            </plugin>


            <!-- ================================================= -->
            <!-- Fat JAR / Uber JAR                                -->
            <!-- ================================================= -->

            <plugin>
                <!-- Plugin para criar um JAR com todas as dependências -->
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-shade-plugin</artifactId>
                <version>3.6.0</version>
                <executions>
                    <!-- ========================================= -->
                    <!-- Cliente                                   -->
                    <!-- ========================================= -->
                    <execution>
                        <id>client-fat-jar</id>
                        <phase>package</phase>
                        <goals>
                            <goal>shade</goal>
                        </goals>
                        <configuration>
                            <finalName>grpc-client</finalName>
                            <!-- Não gerar um dependency-reduced-pom -->
                            <!-- pois o projeto é usado como aplicação. -->
                            <createDependencyReducedPom>false</createDependencyReducedPom>
                            <!-- ================================== -->
                            <!-- Arquivos desnecessários no fat JAR -->
                            <!-- ================================== -->
                            <filters>
                                <filter>
                                    <artifact>*:*</artifact>
                                    <excludes>
                                        <!-- Cada dependência possui seu próprio MANIFEST.MF -->
                                        <exclude>META-INF/MANIFEST.MF</exclude>
                                        <!-- Assinaturas dos JARs originais -->
                                        <exclude>META-INF/*.SF</exclude>
                                        <exclude>META-INF/*.DSA</exclude>
                                        <exclude>META-INF/*.RSA</exclude>
                                        <!-- module-info não é necessário no classpath da aplicação -->
                                        <exclude>META-INF/versions/9/module-info.class</exclude>
                                    </excludes>
                                </filter>
                            </filters>
                            <!-- ================================= -->
                            <!-- Transformers                      -->
                            <!-- ================================= -->
                            <transformers>
                                <!-- Importante para preservar os META-INF/services utilizados pelo gRPC. -->
                                <transformer implementation="org.apache.maven.plugins.shade.resource.ServicesResourceTransformer"/>
                                <!-- Define o Main-Class do JAR -->
                                <transformer implementation="org.apache.maven.plugins.shade.resource.ManifestResourceTransformer">
                                    <mainClass>
                                        br.com.meslin.calculadora.client.CalcClient
                                    </mainClass>
                                </transformer>
                            </transformers>
                        </configuration>
                    </execution>
                    <!-- ========================================= -->
                    <!-- Servidor                                    -->
                    <!-- ========================================= -->
                    <execution>
                        <id>server-fat-jar</id>
                        <phase>package</phase>
                        <goals>
                            <goal>shade</goal>
                        </goals>
                        <configuration>
                            <finalName>grpc-server</finalName>
                            <!-- Não gerar dependency-reduced-pom -->
                            <createDependencyReducedPom>false</createDependencyReducedPom>
                            <!-- ================================= -->
                            <!-- Arquivos desnecessários no fat JAR -->
                            <!-- ================================= -->
                            <filters>
                                <filter>
                                    <artifact>*:*</artifact>
                                    <excludes>
                                        <!-- Manifests das dependências -->
                                        <exclude>META-INF/MANIFEST.MF</exclude>
                                        <!-- Arquivos de configuração -->
                                        <exclude>META-INF/*.properties</exclude>
                                        <!-- Assinaturas -->
                                        <exclude>META-INF/*.SF</exclude>
                                        <exclude>META-INF/*.DSA</exclude>
                                        <exclude>META-INF/*.RSA</exclude>
                                        <!-- module-info não é necessário no classpath -->
                                        <exclude>META-INF/versions/9/module-info.class</exclude>
                                    </excludes>
                                </filter>
                            </filters>
                            <!-- ================================= -->
                            <!-- Transformers                        -->
                            <!-- ================================= -->
                            <transformers>
                                <!-- Preserva os providers registrados
                                     em META-INF/services -->
                                <transformer implementation="org.apache.maven.plugins.shade.resource.ServicesResourceTransformer"/>
                                <!-- Define o Main-Class do JAR -->
                                <transformer implementation="org.apache.maven.plugins.shade.resource.ManifestResourceTransformer">
                                    <mainClass>
                                        br.com.meslin.calculadora.server.CalcServer
                                    </mainClass>
                                </transformer>
                            </transformers>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
